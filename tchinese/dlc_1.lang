<lang>

	<!-- PRIEST -->
	<string name="menu.class.priest">Priest</string>
	<string name="menu.class.priest.description">A holy mystic chosen by the gods to wield the power of divine light and healing.</string>
	
	<string name="htitle.priest.desc">Grants %num% Health Regen, %num-per% per level.</string>

	<!-- Priest Skills -->
	<string name="skills.priest.spell_1.name">Inner Light</string>
	<string name="skills.priest.spell_1.desc">Emits a fiery nova of light that also applies \cb0dfffBlindness\d.</string>
	
	<string name="skills.priest.spell_1.up1.name">Encompassing Light</string>
	<string name="skills.priest.spell_1.up1.desc">Increases the size of the nova.</string>
	
	<string name="skills.priest.spell_1.up2.name">Celestial Light</string>
	<string name="skills.priest.spell_1.up2.desc">Nova hits now have a chance to spawn orbs that shoot beams of light at enemies.</string>
	
	<string name="skills.priest.spell_1.up3.name">Shattering Light</string>
	<string name="skills.priest.spell_1.up3.desc">The nova also applies \cb0dfffVulnerability\d.</string>

	<string name="skills.priest.spell_2.name">Consecrated Ground</string>
	<string name="skills.priest.spell_2.desc">Places a holy circle that saps Health from enemies and transfers it to yourself and any allies standing within.</string>
	
	<string name="skills.priest.spell_2.up1.name">Encompassing Prayer</string>
	<string name="skills.priest.spell_2.up1.desc">Increases the size of the circle.</string>
	
	<string name="skills.priest.spell_2.up2.name">Cleansing Prayer</string>
	<string name="skills.priest.spell_2.up2.desc">Standing in the circle now also reduces debuff duration for all allies.</string>
	
	<string name="skills.priest.spell_2.up3.name">Restoration Prayer</string>
	<string name="skills.priest.spell_2.up3.desc">Allies in the circle are now continuously healed for a percentage of their max Health.</string>

	<string name="skills.priest.passive_1.name">Divine Endurance</string>
	<string name="skills.priest.passive_1.desc">Grants a Mana Shield effect, absorbing a portion of damage received to Mana as long as it's above a certain threshold.</string>
	<string name="skills.priest.passive_1.up1.name">Divine Sustain</string>
	<string name="skills.priest.passive_1.up1.desc">Increases Mana Regen based on your missing Mana percentage.</string>
	
	<string name="skills.priest.passive_1.up2.name">Extended Protection</string>
	<string name="skills.priest.passive_1.up2.desc">Grants an aura that reduces damage received for all nearby allies.</string>
	
	<string name="skills.priest.passive_1.up3.name">Divine Intervention</string>
	<string name="skills.priest.passive_1.up3.desc">Receive Healing when your Health drops below a certain threshold. This ability has some cooldown.</string>

	<string name="skills.priest.passive_2.name">Divine Favor</string>
	<string name="skills.priest.passive_2.desc">Spending or losing Mana gives a stack of \cb0dfffFavor\d. Each stack increases your damage dealt.</string>
	
	<string name="skills.priest.passive_2.up1.name">Holy Flames</string>
	<string name="skills.priest.passive_2.up1.desc">You gain an aura dealing Fire damage to nearby enemies when at max stacks.</string>
	
	<string name="skills.priest.passive_2.up2.name">Restoring Favor</string>
	<string name="skills.priest.passive_2.up2.desc">Each stack now also increases your Mana Regen.</string>
	
	<string name="skills.priest.passive_2.up3.name">Fanaticism</string>
	<string name="skills.priest.passive_2.up3.desc">Damage you deal is increased by the percentage of your missing Mana.</string>	
	
	<!-- SUBLCASSES -->
	<!-- Divine Light -->
	<string name="skills.priest.mastery_1.name">Divine Light</string>
	<string name="skills.priest.mastery_1.desc"></string>
	
	<string name="skills.priest.mastery_1.spell_1.name">Holy Blast</string>
	<string name="skills.priest.mastery_1.spell_1.desc">Charges up and blasts a powerful beam of holy energy that deals mixed Fire and Physical damage.</string>
	
	<string name="skills.priest.mastery_1.spell_1.up1.name">Divine Blast</string>
	<string name="skills.priest.mastery_1.spell_1.up1.desc">Deals additional Fire damage to enemies standing within \cb0dfffConsecrated Ground\d.</string>
	
	<string name="skills.priest.mastery_1.spell_1.up2.name">Massive Blast</string>
	<string name="skills.priest.mastery_1.spell_1.up2.desc">Increases the range of the beam.</string>

	<string name="skills.priest.mastery_1.passive_1.name">Celestial Orbs</string>
	<string name="skills.priest.mastery_1.passive_1.desc">Orbs of light surround you and attack nearby enemies. \cb0dfffHoly Blast\d can be used to focus their fire.</string>
	<string name="skills.priest.mastery_1.passive_1.up1.name">Plentiful Orbs</string>
	<string name="skills.priest.mastery_1.passive_1.up1.desc">Hits from \cb0dfffHoly Blast\d now have a chance to spawn additional orbs.</string>
	
	<string name="skills.priest.mastery_1.passive_1.up2.name">Destructive Orbs</string>
	<string name="skills.priest.mastery_1.passive_1.up2.desc">Enemies killed by orbs have a chance to explode dealing Fire damage in an area.</string>
	
	<!-- Crusader -->	
	<string name="skills.priest.mastery_2.name">Crusader</string>
	<string name="skills.priest.mastery_2.desc"></string>
	
	<string name="skills.priest.mastery_2.spell_1.name">Holy Banner</string>
	<string name="skills.priest.mastery_2.spell_1.desc">Places a banner that grants \cb0dfffInvulnerability\d to you and all allies within its range.</string>
	
	<string name="skills.priest.mastery_2.spell_1.up1.name">Invigorating Banner</string>
	<string name="skills.priest.mastery_2.spell_1.up1.desc">Allies in range now also have increased Attack Speed.</string>
	
	<string name="skills.priest.mastery_2.spell_1.up2.name">War Banner</string>
	<string name="skills.priest.mastery_2.spell_1.up2.desc">The banner now also applies \cb0dfffMarked\d to all enemies in its range.</string>

	<string name="skills.priest.mastery_2.passive_1.name">Call Crusaders</string>
	<string name="skills.priest.mastery_2.passive_1.desc">You passively summon an army of pikemen to fight by your side and attack nearby enemies dealing Physical damage.</string>

	<string name="skills.priest.mastery_2.passive_1.up1.name">Call Crossbowmen</string>
	<string name="skills.priest.mastery_2.passive_1.up1.desc">You now also summon crossbowmen who attack enemies in range dealing Physical damage.</string>
	
	<string name="skills.priest.mastery_2.passive_1.up2.name">Endless Crusaders</string>
	<string name="skills.priest.mastery_2.passive_1.up2.desc">Your crusaders now have a chance to immediately respawn when killed.</string>
	
	<!-- Fllagelant -->
	<string name="skills.priest.mastery_3.name">Flagellant</string>
	<string name="skills.priest.mastery_3.desc"></string>
	
	<string name="skills.priest.mastery_3.spell_1.name">Flagellate</string>
	<string name="skills.priest.mastery_3.spell_1.desc">A wide flail swing that deals Physical damage that's further increased based on your Thorns.</string>
	
	<string name="skills.priest.mastery_3.spell_1.up1.name">Jagged Flail</string>
	<string name="skills.priest.mastery_3.spell_1.up1.desc">Hits from the flail now inflict stacks of \cb0dfffBleeding\d with a chance to apply a stack to yourself.</string>
	
	<string name="skills.priest.mastery_3.spell_1.up2.name">Ecstasy</string>
	<string name="skills.priest.mastery_3.spell_1.up2.desc">Hits from the flail now add stacks of \cb0dfffEcstasy\d. Each stack increases your Thorns.</string>

	<string name="skills.priest.mastery_3.passive_1.name">Retribution</string>
	<string name="skills.priest.mastery_3.passive_1.desc">You gain Thorns, plus additional Thorns based on your maximum Health.</string>
	
	<string name="skills.priest.mastery_3.passive_1.up1.name">Masochism</string>
	<string name="skills.priest.mastery_3.passive_1.up1.desc">You gain a chance to regenerate some Health when hit.</string>
	
	<string name="skills.priest.mastery_3.passive_1.up2.name">Grand Retribution</string>
	<string name="skills.priest.mastery_3.passive_1.up2.desc">Your Thorns deal increased damage to \cb0dfffBosses\d and \cb0dfffElites\d.</string>

