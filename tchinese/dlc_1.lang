	<!-- NPC DIALOGUE -->
	<string name="dialogue.dlc1.priest.intro.prompt1">Welcome to the Chapel! It is here where we revere the Spirits, and adventurers like you face their Trials for blessings of power.</string>
	<string name="dialogue.dlc1.priest.prompt1.1">Are you here to challenge the Trials? No shame in admitting you're not ready yet.</string>
	<string name="dialogue.dlc1.priest.prompt1.2">Bless the Spirits, adventurer, and their holy power.</string>
	<string name="dialogue.dlc1.priest.prompt1.3">Reach for the power the Spirits grant, hero. But beware of the Trials!</string>

	<string name="dialogue.dlc1.petstore.intro.prompt1">Hello! Are you here to get a trusty friend for your dungeoneering enterprises?</string>
	<string name="dialogue.dlc1.petstore.prompt1.1">Do you need a friend to share the burden of adventuring with you?</string>
	<string name="dialogue.dlc1.petstore.prompt1.2">Most heroes go for the flying candle thing. But me? I'm a cat person.</string>
	<string name="dialogue.dlc1.petstore.prompt1.3">Remember that pets are good both for your health and soul!</string>
	

