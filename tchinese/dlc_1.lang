	<!-- PRIEST -->
	<string name="menu.class.priest">牧師</string>
	<string name="menu.class.priest.description">一位被眾神選中，能揮動神聖之光與治癒之力的神聖秘術師</string>
	
	<string name="htitle.priest.desc">獲得 %num% 點生命回復，每等級增加 %num-per%</string>

	<!-- Priest Skills -->
	<string name="skills.priest.spell_1.name">內在之光</string>
	<string name="skills.priest.spell_1.desc">發射一道熾熱的光之新星，並施加\cb0dfff致盲\d</string>
	
	<string name="skills.priest.spell_1.up1.name">涵蓋之光</string>
	<string name="skills.priest.spell_1.up1.desc">增加新星的範圍</string>
	
	<string name="skills.priest.spell_1.up2.name">蒼穹之光</string>
	<string name="skills.priest.spell_1.up2.desc">新星擊中敵人時有機率產生光球，光球會向敵人發射光束</string>
	
	<string name="skills.priest.spell_1.up3.name">破碎之光</string>
	<string name="skills.priest.spell_1.up3.desc">新星額外施加\cb0dfff脆弱\d</string>

	<string name="skills.priest.spell_2.name">聖潔之地</string>
	<string name="skills.priest.spell_2.desc">放置一個神聖法陣，吸取敵人的生命並轉移給站在法陣內的自己及盟友</string>
	
	<string name="skills.priest.spell_2.up1.name">涵蓋祈禱</string>
	<string name="skills.priest.spell_2.up1.desc">增加法陣的範圍</string>
	
	<string name="skills.priest.spell_2.up2.name">淨化祈禱</string>
	<string name="skills.priest.spell_2.up2.desc">現在站在法陣內還會減少所有盟友的減益效果持續時間</string>
	
	<string name="skills.priest.spell_2.up3.name">恢復祈禱</string>
	<string name="skills.priest.spell_2.up3.desc">法陣內的盟友現在會持續治療，數值為其最大生命值的百分比</string>

	<string name="skills.priest.passive_1.name">神聖耐力</string>
	<string name="skills.priest.passive_1.desc">獲得魔力護盾效果，只要魔力值高於特定閾值，便會吸收部分受到的傷害至魔力值</string>
	<string name="skills.priest.passive_1.up1.name">神聖維持</string>
	<string name="skills.priest.passive_1.up1.desc">根據缺失魔力值百分比增加魔力回復</string>
	
	<string name="skills.priest.passive_1.up2.name">延伸守護</string>
	<string name="skills.priest.passive_1.up2.desc">獲得一個光環，減少所有附近盟友受到的傷害</string>
	
	<string name="skills.priest.passive_1.up3.name">神聖干預</string>
	<string name="skills.priest.passive_1.up3.desc">當生命值低於特定閾值時獲得治療，此能力有冷卻時間</string>

	<string name="skills.priest.passive_2.name">神聖恩寵</string>
	<string name="skills.priest.passive_2.desc">消耗或失去魔力值會獲得一層\cb0dfff恩寵\d，每層增加你造成的傷害</string>
	
	<string name="skills.priest.passive_2.up1.name">聖火</string>
	<string name="skills.priest.passive_2.up1.desc">層數達到上限時，你會獲得一個光環，對附近敵人造成火焰傷害</string>
	
	<string name="skills.priest.passive_2.up2.name">恢復恩寵</string>
	<string name="skills.priest.passive_2.up2.desc">每層現在還會增加你的魔力回復</string>
	
	<string name="skills.priest.passive_2.up3.name">狂熱</string>
	<string name="skills.priest.passive_2.up3.desc">你造成的傷害隨缺失魔力值百分比而增加</string>	
	
